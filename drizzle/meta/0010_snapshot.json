        "site_settings_analytics": {
          "name": "site_settings_analytics",
          "value": "coalesce(\n        (\"site_settings\".\"analyticsProvider\" is null and \"site_settings\".\"analyticsId\" is null)\n        or (\"site_settings\".\"analyticsProvider\" = 'plausible' and \"site_settings\".\"analyticsId\" ~ '^[a-z0-9-]+(\\.[a-z0-9-]+)+$' and char_length(\"site_settings\".\"analyticsId\") <= 253)\n        or (\"site_settings\".\"analyticsProvider\" = 'google' and \"site_settings\".\"analyticsId\" ~ '^G-[A-Z0-9]{4,20}$'),\n        false)"
        }
      },
