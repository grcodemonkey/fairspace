DATABASE_URL=postgres://fairspace:fairspace@localhost:5433/fairspace
# Neon direct URL: migrations use it when set. The Vercel Neon integration sets it.
# DATABASE_URL_UNPOOLED=
# TEST_DATABASE_URL=postgres://fairspace:fairspace@localhost:5433/fairspace_test

# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Magic links are built from this URL. Set it on self-hosted installs (optional on Vercel: set it with a custom domain). Also set it at build time: static pages bake canonical and og:image URLs.
AUTH_URL=http://localhost:3000

# Local Mailpit (pnpm db:up). For Resend: smtp://resend:<API_KEY>@smtp.resend.com:465
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Fairspace <noreply@localhost>

# The first sign-in with this email creates the admin. Used only while no admin exists.
ADMIN_EMAIL=admin@localhost

# Media storage: any S3-compatible bucket. These values match local SeaweedFS (pnpm db:up).
# Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false
# Backblaze B2:  S3_ENDPOINT=https://s3.<region>.backblazeb2.com, S3_REGION=<region>, S3_FORCE_PATH_STYLE=true
# AWS S3:        leave S3_ENDPOINT empty, S3_REGION=<region>, S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=fairspace
S3_ACCESS_KEY_ID=fairspace
S3_SECRET_ACCESS_KEY=fairspace
S3_FORCE_PATH_STYLE=true
